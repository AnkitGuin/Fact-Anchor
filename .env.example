# ---------------------------------------------------------------------------
# FactAnchor environment variables (placeholders only -- never commit real keys)
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in as needed.  The code reads these with sensible
# defaults, so an empty file is fine for offline/local use.

# --- Knowledge source -------------------------------------------------------
# Base URL of the Wikibase/Wikidata-compatible API.  Override for a local
# mirror or a test double.  Must expose `wbsearchentities` and `wbgetentities`.
FACTANCHOR_WIKIDATA_API=https://www.wikidata.org/w/api.php

# A descriptive User-Agent is REQUIRED by the Wikimedia API policy.
# https://meta.wikimedia.org/wiki/User-Agent_policy
FACTANCHOR_USER_AGENT=FactAnchor/0.1 (research prototype; contact: you@example.org)

# Read-only contact e-mail is requested (not required) by Wikimedia.
FACTANCHOR_CONTACT=you@example.org

# Max requests per second towards the knowledge API (client-side rate limit).
FACTANCHOR_RATE_LIMIT_PER_SECOND=5

# Per-request connect/read timeout in seconds.
FACTANCHOR_REQUEST_TIMEOUT=10.0

# Retries for transient HTTP failures (429/5xx/timeouts) with bounded backoff.
FACTANCHOR_MAX_RETRIES=3

# On-disk HTTP cache directory (git-ignored).
FACTANCHOR_CACHE_DIR=.cache/factanchor

# TTL for cached knowledge lookups, seconds (30 days).
FACTANCHOR_CACHE_TTL=2592000

# Fallback behaviour when the knowledge service is unavailable:
#   cache_only | no_facts | error
FACTANCHOR_RETRIEVAL_FALLBACK=cache_only

# --- Model ------------------------------------------------------------------
# Default model for experiments (Llama-3-8B-Instruct needs a HF license click
# and >=16 GB RAM; use a small model locally, e.g. sshleifer/tiny-gpt2 or
# HuggingFaceTB/SmolLM2-135M-Instruct).
FACTANCHOR_MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct

# Weight revision to pin for reproducibility (branch, tag or commit hash).
FACTANCHOR_MODEL_REVISION=main

# Optional Hugging Face access token (only for gated repos such as Llama 3).
# HF_TOKEN=

# --- Storage -----------------------------------------------------------------
FACTANCHOR_OUTPUT_DIR=artifacts
# Set to 1 to allow re-using an existing run directory (never overwrites files
# silently: it appends a suffix and records the collision).
FACTANCHOR_ALLOW_RUN_DIR_REUSE=0
